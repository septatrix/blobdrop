#!/bin/sh
set -e
appdir=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
# Include indirect dependencies, including on systems whose library dir is lib64.
export LD_LIBRARY_PATH="$appdir/@CMAKE_INSTALL_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$appdir/@CMAKE_INSTALL_BINDIR@/blobdrop" "$@"
